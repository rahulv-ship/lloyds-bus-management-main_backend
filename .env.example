# Store these only in backend/.env. Never put them in the frontend or commit real values.
HONO_HR_TOKEN=replace_with_honohr_token
HONO_HR_COMPCODE=lloyds
# Optional: defaults to the HonoHR employee endpoint from the supplied reference.
HONO_EMPLOYEE_API_URL=https://lloyds.honohr.com/sapi/Fetch_employees/getAllEmployeeInfo
# HonoHR reference range; use a smaller value only if the provider confirms filtering is reliable.
HONO_HR_PAGE_SIZE=6000

# Wheelseye GPS API
WHEELSEYE_TOKEN=98a3355b-4498-48bb-8b70-7b0b04475788


